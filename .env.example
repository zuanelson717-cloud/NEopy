# Variáveis de Ambiente - NEopy
# Copie este arquivo para .env e preencha com seus dados

# ========== FIREBASE/GOOGLE CLOUD ==========
# Coloque sua Chave de API aqui
FIREBASE_API_KEY=sua_chave_de_api_aqui
FIREBASE_PROJECT_ID=ais-europe-west2
FIREBASE_STORAGE_BUCKET=seu-bucket.appspot.com

# ========== BANCO DE DADOS ==========
DATABASE_NAME=neopy.db
DATABASE_PATH=database/neopy.db

# ========== APLICAÇÃO ==========
APP_DEBUG=True
APP_THEME=modern

# ========== DIRETÓRIOS DE SAÍDA ==========
PDF_OUTPUT_DIR=output/pdf/
EXCEL_OUTPUT_DIR=output/excel/
PASSES_OUTPUT_DIR=output/passes/
